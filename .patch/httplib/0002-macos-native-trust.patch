+namespace detail {
+// Evaluate the peer's untrusted chain using platform policy, not an exported
+// list of anchors. Exporting Keychain certificates loses explicit distrust,
+// purpose/hostname restrictions, and the user's trust-domain precedence.
+inline bool verify_macos_server_trust(tls::session_t session,
+                                      const char *hostname) {
+  auto ssl = static_cast<SSL *>(session);
+  auto leaf = SSL_get1_peer_certificate(ssl);
+  if (!leaf) { return false; }
+  auto leaf_guard = scope_exit([&] { X509_free(leaf); });
+  auto certificates = CFArrayCreateMutable(nullptr, 0, &kCFTypeArrayCallBacks);
+  if (!certificates) { return false; }
+  auto certificates_guard = scope_exit([&] { CFRelease(certificates); });
+  const auto append = [&](X509 *certificate) {
+    const int length = i2d_X509(certificate, nullptr);
+    if (length <= 0) { return false; }
+    std::vector<unsigned char> der(static_cast<size_t>(length));
+    auto cursor = der.data();
+    if (i2d_X509(certificate, &cursor) != length) { return false; }
+    auto data = CFDataCreate(nullptr, der.data(), length);
+    if (!data) { return false; }
+    auto native_certificate = SecCertificateCreateWithData(nullptr, data);
+    CFRelease(data);
+    if (!native_certificate) { return false; }
+    CFArrayAppendValue(certificates, native_certificate);
+    CFRelease(native_certificate);
+    return true;
+  };
+  if (!append(leaf)) { return false; }
+  auto chain = SSL_get_peer_cert_chain(ssl);
+  for (int i = 0; chain && i < sk_X509_num(chain); ++i) {
+    auto certificate = sk_X509_value(chain, i);
+    if (X509_cmp(certificate, leaf) != 0 && !append(certificate)) { return false; }
+  }
+  auto host = hostname ? CFStringCreateWithCString(nullptr, hostname,
+                                                  kCFStringEncodingUTF8)
+                       : nullptr;
+  if (hostname && !host) { return false; }
+  auto host_guard = scope_exit([&] { if (host) { CFRelease(host); } });
+  auto policy = SecPolicyCreateSSL(true, host);
+  if (!policy) { return false; }
+  auto policy_guard = scope_exit([&] { CFRelease(policy); });
+  SecTrustRef trust = nullptr;
+  if (SecTrustCreateWithCertificates(certificates, policy, &trust) != errSecSuccess ||
+      !trust) {
+    if (trust) { CFRelease(trust); }
+    return false;
+  }
+  auto trust_guard = scope_exit([&] { CFRelease(trust); });
+  // Use the supplied chain and local trust store. Do not start unbounded AIA /
+  // OCSP network requests outside the HTTP client's configured timeouts.
+  if (SecTrustSetNetworkFetchAllowed(trust, false) != errSecSuccess) { return false; }
+  CFErrorRef error = nullptr;
+  const bool accepted = SecTrustEvaluateWithError(trust, &error);
+  if (error) { CFRelease(error); }
+  return accepted;
+}
+} // namespace detail
+#endif
